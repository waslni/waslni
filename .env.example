# Supabase project settings. The publishable key is designed for browser use;
# protect every exposed table with Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secrets belong in Supabase Edge Function Secrets, never here:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
